rules_version = '2';

// Mikro - Firestore güvenlik kuralları
//
// Not: n8n akışı Admin/servis hesabıyla çalıştığı için kurallara takılmaz
// (sorular belgesine çözüm bilgisi yazması, premium alanını elle değiştirmek vb.).
// Aşağıdaki kurallar yalnızca uygulamadaki istemci erişimini sınırlar.
//
// Koleksiyonlar:
//   kullanicilar/{uid}        profil; sahibi okur/yazar, bağlı veli okur. premiumMu istemciden yazılamaz.
//   sorular/{id}              sorular; sahibi okur/siler, bağlı veli okur. Yeni soru "Bekliyor" durumunda açılır.
//   baglantiKodlari/{KOD}     öğrenci bağlantı kodu -> uid. Kodu bilen tek tek okuyabilir, listelenemez.
//   cihazHaklari/{cihazId}    eski istemci kotası (kullanılmıyor, kapalı); kota artık sunucuda: kotaSayaclari
//   kurumlar/{kurumId}        dershane. Yalnızca sunucu (Admin SDK / Cloud Functions) yazar.
//     /ozet/{uid}             öğrenci başına istatistik özeti; müdür ve "tum" kapsamlı öğretmen okur.
//     /gruplar/{grupId}       sınıf/şube; /ozet/{uid} altındaki grup kopyasını yetkili öğretmen okur.
//     /duyurular/{id}         müdürün duyuru yönetim listesi; yalnızca müdür okur.
//     /duyuruKutusu/{kutu}/duyurular/{id}  öğrencilere teslim kopyası; kutu "hepsi" ya da öğrencinin grubu.
//     /uyeler/{uid}           öğrenci üyeliği ve onay kaydı; müdür ve öğrencinin kendisi okur.
//     /yoneticiler/{eposta}   müdür/öğretmen davetleri; yalnızca müdür okur.
//   diğer her şey (örn. questions)  istemciye kapalı.
//
// Kurum yetkisi sunucunun yazdığı kimlik claim'lerinden gelir (request.auth.token):
//   kurumId  -> yöneticinin kurumu, kurumRol -> 'mudur' ya da 'ogretmen'.
//   kapsam   -> öğretmenin kapsamı: 'tum' (varsayılan) ya da 'gruplar'; gruplar -> erişebildiği grup kimlikleri.
// İstemci kurumId, kurumRol, premiumMu, veli bağlantı alanlarını, bağlantı kodunu ve 'yonetici' rolünü yazamaz.

service cloud.firestore {
  match /databases/{database}/documents {

    function girisli() {
      return request.auth != null;
    }

    function ben(uid) {
      return girisli() && request.auth.uid == uid;
    }

    // Veli belgesinde bagliOgrenciIdleri listesi olan ve bu öğrenciyi içeren kullanıcı
    function veliMi(ogrenciUid) {
      return girisli() &&
        ogrenciUid in get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.get('bagliOgrenciIdleri', []);
    }

    // Soru belgesinin sahibi: uid ya da e-posta eşleşmesi
    function soruSahibi(soru) {
      return girisli() &&
        (soru.kullaniciUid == request.auth.uid ||
         soru.kullaniciEposta == request.auth.token.email);
    }

    // Kurum etkin mi? Askıya alınan ya da kapatılan kurumun yöneticileri, claim'leri belirteçte kalsa bile
    // hiçbir kurum verisini okuyamaz. Kurum belgesi yoksa get() hata verir ve kural reddeder.
    function kurumAktif(kurumId) {
      return get(/databases/$(database)/documents/kurumlar/$(kurumId)).data.get('durum', '') == 'aktif';
    }

    // Sunucunun verdiği kurum claim'leri (kurumun durumuna bakmaz; yalnızca kurum belgesinin kendisi için)
    function mudurClaim(kurumId) {
      return girisli()
        && request.auth.token.get('kurumRol', '') == 'mudur'
        && request.auth.token.get('kurumId', '') == kurumId;
    }

    function yoneticiClaim(kurumId) {
      return girisli()
        && request.auth.token.get('kurumRol', '') in ['mudur', 'ogretmen']
        && request.auth.token.get('kurumId', '') == kurumId;
    }

    // Kurum verisine erişim: claim VE kurum aktif
    function mudurMu(kurumId) {
      return mudurClaim(kurumId) && kurumAktif(kurumId);
    }

    function kurumYoneticisiMi(kurumId) {
      return yoneticiClaim(kurumId) && kurumAktif(kurumId);
    }

    // Öğretmenin kapsamı sunucunun yazdığı claim'den gelir: "tum" (claim yoksa da bu sayılır, bu
    // özellikten önce eklenmiş öğretmenler çalışmaya devam eder) ya da "gruplar".
    // Müdür her zaman tüm kurumu görür. İstemci claim yazamaz.
    function tumKapsamMi(kurumId) {
      return mudurMu(kurumId)
        || (kurumYoneticisiMi(kurumId)
            && request.auth.token.get('kapsam', 'tum') == 'tum');
    }

    // Bir grubun öğrenci özetlerine erişim: tüm kapsam ya da claim'deki gruplardan biri
    function grupKapsamiMi(kurumId, grupId) {
      return tumKapsamMi(kurumId)
        || (kurumYoneticisiMi(kurumId)
            && request.auth.token.get('kapsam', 'tum') == 'gruplar'
            && grupId in request.auth.token.get('gruplar', []));
    }

    // Duyuru kutusu: kurumun üyesi olan öğrenci "hepsi" kutusunu ve yalnızca KENDİ grubunun kutusunu okur.
    // Kutu kimliği yoldan gelir; kural sorgu içeriğine değil yola bakar.
    function uyeKutusuMu(kurumId, kutuId) {
      return girisli()
        && exists(/databases/$(database)/documents/kurumlar/$(kurumId)/uyeler/$(request.auth.uid))
        && (kutuId == 'hepsi'
            || get(/databases/$(database)/documents/kurumlar/$(kurumId)/uyeler/$(request.auth.uid)).data.get('grupId', '') == kutuId);
    }

    // Kullanıcı yalnızca kendi seçebileceği rolleri yazabilir
    function istemciRolleri() {
      return ['ogrenci', 'veli'];
    }

    function degisenAnahtarlar() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Profil fotoğrafı yalnızca kullanıcının kendi Storage dosyasının indirme bağlantısı olabilir.
    // (Başka bir adres yazılırsa veli ekranı o siteye bağlanırdı: IP/zaman sızıntısı.)
    function profilFotoGecerli(uid, deger) {
      return deger is string && deger.size() < 300 &&
        deger.matches('https://firebasestorage[.]googleapis[.]com/v0/b/project-21-3e377[.]firebasestorage[.]app/o/profil_fotograflari%2F' + uid + '[.]jpg[?]alt=media&token=[0-9a-fA-F-]{36}');
    }

    // Ad soyad velide ve dershane raporlarında görünür: metin ve en fazla 60 karakter (uygulama 40'ta keser)
    function adSoyadGecerli(deger) {
      return deger is string && deger.size() >= 1 && deger.size() <= 60;
    }

    // Veli–öğrenci bağlantısı ve bağlantı kodu yalnızca sunucuda (veliBagla / baglantiKoduAl) yazılır.
    // Bu alanları istemci yazabilseydi, veliMi() kod bilmeden herhangi bir öğrenciye erişim verirdi.
    function sunucuAlanlari() {
      return ['premiumMu', 'kurumId', 'kurumRol', 'bagliOgrenciIdleri', 'bagliOgrenciler', 'baglantiKodu'];
    }

    // Yeni belge: alan varsa geçerli olmalı
    function profilAlanlariGecerliYeni(uid, veri) {
      return (!('profilFoto' in veri) || profilFotoGecerli(uid, veri.profilFoto))
        && (!('adSoyad' in veri) || adSoyadGecerli(veri.adSoyad));
    }

    // Güncelleme: yalnızca değişen alan denetlenir (silinmesi serbest), eski kayıtlar kilitlenmez
    function profilAlanlariGecerliGuncelleme(uid) {
      return (!degisenAnahtarlar().hasAny(['profilFoto'])
              || !('profilFoto' in request.resource.data)
              || profilFotoGecerli(uid, request.resource.data.profilFoto))
        && (!degisenAnahtarlar().hasAny(['adSoyad'])
              || !('adSoyad' in request.resource.data)
              || adSoyadGecerli(request.resource.data.adSoyad));
    }

    // ---------------------------------------------------------------- kullanicilar
    match /kullanicilar/{uid} {
      // Müdür öğrenci profilini doğrudan okuyamaz; yönetici verisi yalnızca sunucu üzerinden (erişim kaydıyla) verilir
      allow get: if ben(uid) || veliMi(uid);
      allow list: if false;

      allow create: if ben(uid)
        && !request.resource.data.keys().hasAny(sunucuAlanlari())
        && request.resource.data.get('rol', 'ogrenci') in istemciRolleri()
        && profilAlanlariGecerliYeni(uid, request.resource.data);

      allow update: if ben(uid)
        && !degisenAnahtarlar().hasAny(sunucuAlanlari())
        && profilAlanlariGecerliGuncelleme(uid)
        && (!degisenAnahtarlar().hasAny(['rol'])
            || (request.resource.data.rol in istemciRolleri()
                && resource.data.get('rol', 'ogrenci') in istemciRolleri()));

      allow delete: if ben(uid);
    }

    // ---------------------------------------------------------------- sorular
    match /sorular/{soruId} {
      allow read: if soruSahibi(resource.data)
        || veliMi(resource.data.kullaniciUid);
      // Müdür soruları doğrudan okuyamaz: yalnızca sunucu fonksiyonları (erişim kaydı tutarak) verir

      // Soru belgesini yalnızca sunucu (soruGonder) oluşturur: günlük kota sunucuda sayılır ve
      // fotoğraf doğrulanır. İstemci doğrudan soru yazamaz.
      allow create: if false;

      // Sahibi yalnızca okundu damgası ve ders alanını değiştirebilir
      allow update: if soruSahibi(resource.data)
        && degisenAnahtarlar().hasOnly(['okunduMu', 'ders', 'dersKaynak'])
        && (!degisenAnahtarlar().hasAny(['okunduMu']) || request.resource.data.okunduMu is bool)
        && (!degisenAnahtarlar().hasAny(['ders'])
            || (request.resource.data.ders is string && request.resource.data.ders.size() <= 30))
        && (!degisenAnahtarlar().hasAny(['dersKaynak'])
            || request.resource.data.dersKaynak in ['kullanici', 'cozum', 'tahmin']);

      allow delete: if soruSahibi(resource.data);
    }

    // ---------------------------------------------------------------- kurumlar
    // Tüm yazmalar sunucuya aittir (varsayılan: istemci yazamaz).
    match /kurumlar/{kurumId} {
      // Kurum belgesi (ad, durum, lisans) askıdayken de okunur; böylece yönetici ekranı durumu gösterebilir
      allow get: if yoneticiClaim(kurumId);
      allow list: if false;

      // Kurum geneli öğrenci özetleri: müdür ve "tum" kapsamlı öğretmenler
      match /ozet/{uid} {
        allow read: if tumKapsamMi(kurumId);
        allow write: if false;
      }

      // Gruplar (sınıf/şube): adları tüm yöneticiler okur. Öğrenci özetlerinin grup kopyaları yalnızca
      // yetkili öğretmene ve müdüre açıktır (yol bazlı kural: sorgu içeriğine bağlı değildir).
      match /gruplar/{grupId} {
        allow read: if kurumYoneticisiMi(kurumId);
        allow write: if false;

        match /ozet/{uid} {
          allow read: if grupKapsamiMi(kurumId, grupId);
          allow write: if false;
        }
      }

      // Duyurular: müdürün yönetim listesi (gönderen e-postası içerir). Yazma yalnızca sunucuda.
      match /duyurular/{duyuruId} {
        allow read: if mudurMu(kurumId);
        allow write: if false;
      }

      // Duyuru teslim kutuları: "hepsi" ya da bir grubun kimliği. Öğrenciler yalnızca okur.
      match /duyuruKutusu/{kutuId}/duyurular/{duyuruId} {
        allow read: if uyeKutusuMu(kurumId, kutuId);
        allow write: if false;
      }

      match /uyeler/{uid} {
        allow get: if ben(uid) || mudurMu(kurumId);
        allow list: if mudurMu(kurumId);
        allow write: if false;
      }

      match /yoneticiler/{eposta} {
        allow read: if mudurMu(kurumId);
        allow write: if false;
      }

      // KVKK erişim kayıtları: yalnızca müdür okur, yalnızca sunucu yazar (12 ay sonra silinir)
      match /erisimKayitlari/{kayitId} {
        allow read: if mudurMu(kurumId);
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------- platformYoneticileri
    // Platform yöneticisi listesi yalnızca Console'dan yazılır ve yalnızca sunucu okur; istemciye tamamen kapalı.
    match /platformYoneticileri/{eposta} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- baglantiKodlari
    // Kod → öğrenci eşlemesi istemciye tamamen kapalı: kodlar sunucuda üretilir, veli bağlantısı sunucuda kurulur
    // (yanlış deneme sınırıyla). İstemci okuyabilseydi kodları tarayıp öğrenci kimliklerini bulabilirdi.
    match /baglantiKodlari/{kod} {
      allow read, write: if false;
    }

    // Veli kod deneme sayaçları: yalnızca sunucu
    match /veliDenemeleri/{uid} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- cihazHaklari
    match /cihazHaklari/{cihazId} {
      // Eski (istemci tarafı) kota kaydı: artık kullanılmıyor, yazma kapalı. Kota sunucuda sayılır.
      allow read, write: if false;
    }

    // Sunucu kota sayaçları ve ayarlar: istemciye tamamen kapalı (yalnızca Admin SDK)
    match /kotaSayaclari/{kayitId} {
      allow read, write: if false;
    }

    match /ayarlar/{ayarId} {
      allow read, write: if false;
    }
  }
}
