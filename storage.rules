rules_version = '2';

// Firebase Storage güvenlik kuralları. Yayınlama: Firebase Console > Storage > Rules
// (ya da `firebase deploy --only storage`; bunun için firebase.json'a "storage" girdisi gerekir).
//
// İlke: kimse başkasının dosyasını doğrudan okuyamaz. Müdür/öğretmen dahil yöneticiler Storage'dan
// hiçbir şey okuyamaz; müdür öğrenci verisini yalnızca erişim kaydı tutan sunucu fonksiyonlarıyla alır.
// n8n servis hesabı kurallara tabi değildir ve çözüm dosyalarını yazar (istemci yazamaz).
service firebase.storage {
  match /b/{bucket}/o {

    function girisli() {
      return request.auth != null;
    }

    // Klasör sahibi: yeni sistem UID klasörü; eski sistem e-posta klasörü.
    // Dosya İÇERİĞİNİ okumak için e-postanın doğrulanmış olması gerekir.
    function sahibi(sahip) {
      return girisli()
        && (request.auth.uid == sahip
            || (request.auth.token.email_verified == true && request.auth.token.email == sahip));
    }

    // Dosya adlarını listelemek ve silmek (hesap/soru silme akışları) doğrulanmamış e-posta sahibine de açıktır;
    // içerik okunamaz ve yalnızca kendi e-postasının klasörüne dokunabilir.
    function silebilir(sahip) {
      return girisli()
        && (request.auth.uid == sahip || request.auth.token.email == sahip);
    }

    // Veli belgesinde bagliOgrenciIdleri listesi olan ve bu öğrenciyi içeren kullanıcı
    // (Firestore kurallarındaki veliMi ile aynı mantık; e-posta klasörleri için veli erişimi yoktur)
    function veliMi(ogrenciUid) {
      return girisli()
        && ogrenciUid in firestore.get(/databases/(default)/documents/kullanicilar/$(request.auth.uid)).data.get('bagliOgrenciIdleri', []);
    }

    // Soru fotoğrafları: yalnızca sahibi
    match /kullanicilar/{uid}/{allPaths=**} {
      allow read: if girisli() && request.auth.uid == uid;
      allow create, update: if girisli() && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if girisli() && request.auth.uid == uid;
    }

    // Profil fotoğrafı: yalnızca sahibi okur/yazar
    match /profil_fotograflari/{dosya} {
      allow read: if girisli() && dosya == request.auth.uid + '.jpg';
      allow create, update: if girisli()
        && dosya == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if girisli() && dosya == request.auth.uid + '.jpg';
    }

    // Çözüm dosyaları (JSON ve çözüm kartı resmi): n8n yazar. Sahibi ve bağlı veli okur; yalnızca sahibi siler.
    match /cozumDetayi/{sahip}/{dosya} {
      allow get: if sahibi(sahip) || veliMi(sahip);
      allow list: if silebilir(sahip) || veliMi(sahip);
      allow delete: if silebilir(sahip);
      allow create, update: if false;
    }

    match /solution-cards/{sahip}/{dosya} {
      allow get: if sahibi(sahip) || veliMi(sahip);
      allow list: if silebilir(sahip) || veliMi(sahip);
      allow delete: if silebilir(sahip);
      allow create, update: if false;
    }

    // Diğer her yol kapalıdır
    match /{tum=**} {
      allow read, write: if false;
    }
  }
}
